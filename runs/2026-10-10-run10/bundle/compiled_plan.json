  "derived": [
    {
      "name": "dm_selfreport",
      "expr": "DIQ010 == 1",
      "type": "binary",
      "label": "Self-reported diabetes diagnosis",
      "levels": null
    },
    {
      "name": "insulin_use",
      "expr": "DIQ050 == 1",
      "type": "binary",
      "label": "Current insulin use",
      "levels": null
    },
    {
      "name": "dm_pills",
      "expr": "DIQ070 == 1",
      "type": "binary",
      "label": "Current oral diabetes medication",
      "levels": null
    },
    {
      "name": "hba1c",
      "expr": "LBXGH",
      "type": "continuous",
      "label": "HbA1c",
      "levels": null
    },
    {
      "name": "diabetes_ada",
      "expr": "any_of(dm_selfreport, insulin_use, dm_pills, hba1c >= 6.5)",
      "type": "binary",
      "label": "Diabetes - self-report, medication, or HbA1c >=6.5%",
      "levels": null
    },
    {
      "name": "vigorous_pa",
      "expr": "PAQ650 == 1",
      "type": "binary",
      "label": "Any vigorous recreational activity",
      "levels": null
    },
    {
      "name": "age",
      "expr": "RIDAGEYR",
      "type": "continuous",
      "label": "Age",
      "levels": null
    },
    {
      "name": "female",
      "expr": "RIAGENDR == 2",
      "type": "binary",
      "label": "Female sex",
      "levels": null
    },
    {
      "name": "sex",
      "expr": "cases(female == 0, \"Male\", female == 1, \"Female\")",
      "type": "categorical",
      "label": "Sex",
      "levels": null
    },
    {
      "name": "race_eth",
      "expr": "cases(RIDRETH3 == 3, \"Non-Hispanic White\", RIDRETH3 == 4, \"Non-Hispanic Black\", RIDRETH3 %in% c(1, 2), \"Hispanic\", RIDRETH3 == 6, \"Non-Hispanic Asian\", RIDRETH3 == 7, \"Other or multiracial\")",
      "type": "categorical",
      "label": "Race and ethnicity",
      "levels": null
    },
    {
      "name": "pir",
      "expr": "INDFMPIR",
      "type": "continuous",
      "label": "Family income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "pir_cat",
      "expr": "cases(pir < 1.3, \"<1.30\", pir < 3.5, \"1.30-3.49\", pir >= 3.5, \"3.50+\")",
      "type": "categorical",
      "label": "Income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "educ",
      "expr": "cases(DMDEDUC2 %in% c(1, 2), \"Less than high school\", DMDEDUC2 == 3, \"High school or GED\", DMDEDUC2 == 4, \"Some college\", DMDEDUC2 == 5, \"College graduate or above\")",
      "type": "categorical",
      "label": "Educational attainment",
      "levels": null
    },
    {
      "name": "smoking",
      "expr": "cases(SMQ020 == 2, \"Never\", SMQ040 == 3, \"Former\", SMQ040 %in% c(1, 2), \"Current\")",
      "type": "categorical",
      "label": "Smoking status",
      "levels": null
    },
    {
      "name": "bmi",
      "expr": "BMXBMI",
      "type": "continuous",
      "label": "Body mass index",
      "levels": null
    },
    {
      "name": "agecat",
      "expr": "cases(age < 18, \"<18\", age < 40, \"18-39\", age < 65, \"40-64\", age >= 65, \"65+\")",
      "type": "categorical",
      "label": "Age group",
      "levels": null
    },
    {
      "name": "pregnant",
      "expr": "coalesce(RIDEXPRG, 2) == 1",
      "type": "binary",
      "label": "Pregnant at examination",
      "levels": null
    },
    {
      "name": "hgb",
      "expr": "LBXHGB",
      "type": "continuous",
      "label": "Hemoglobin",
      "levels": null
    },
    {
      "name": "anemia",
      "expr": "hgb < ifelse(female == 0, 13, ifelse(pregnant == 1, 11, 12))",
      "type": "binary",
      "label": "Anemia (WHO hemoglobin thresholds)",
      "levels": null
    }
  ],
