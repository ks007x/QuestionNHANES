        "type": "exclude",
        "label": "Exclude participants aware of the diagnosis (reverse causation)",
        "expr": "any_of(coalesce(dm_pills, 0) == 1, coalesce(dm_selfreport, 0) == 1, coalesce(insulin_use, 0) == 1)",
