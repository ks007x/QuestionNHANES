    "missing": {
      "method": "complete_case",
      "m": 10
    },
    "sensitivity": [
      {
        "type": "exclude",
        "label": "Exclude participants on glucose-lowering therapy",
        "expr": "coalesce(insulin_use, 0) == 1 | coalesce(dm_pills, 0) == 1",
        "id": "s1"
      },
      {
        "type": "exclude",
        "label": "Exclude anemia (HbA1c unreliable)",
        "expr": "coalesce(anemia, 0) == 1",
        "id": "s2"
      },
      {
        "type": "alt_family",
        "label": "Logistic regression (odds ratio)",
        "family": "quasibinomial",
        "id": "s3"
      },
      {
        "type": "mi",
        "label": "Multiple imputation of missing covariates (m = 10)",
        "m": 10,
        "id": "s4"
      },
      {
        "type": "unweighted",
        "label": "Unweighted analysis (design ignored)",
        "id": "s5"
      },
