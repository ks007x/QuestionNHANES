  "trace": [
    "# data: P_DEMO, P_BMX, P_CBC",
    "aec <- LBDEONO",
    "hypereosinophilia_15 <- aec >= 1.5",
    "age <- RIDAGEYR",
    "female <- RIAGENDR == 2",
    "sex <- cases(female == 0, \"Male\", female == 1, \"Female\")",
    "race_eth <- coalesce(cases(RIDRETH3 == 3, \"Non-Hispanic White\", RIDRETH3 == 4, \"Non-Hispanic Black\", RIDRETH3 %in% c(1, 2), \"Hispanic\", RIDRETH3 == 6, \"Non-Hispanic Asian\", RIDRETH3 == 7, \"Other or multiracial\"), cases(RIDRETH1 == 3, \"Non-Hispanic White\", RIDRETH1 == 4, \"Non-Hispanic Black\", RIDRETH1 %in% c(1, 2), \"Hispanic\", RIDRETH1 == 5, \"Other or multiracial\"))",
    "pir <- INDFMPIR",
    "pir_cat <- cases(pir < 1.3, \"<1.30\", pir < 3.5, \"1.30-3.49\", pir >= 3.5, \"3.50+\")",
    "bmi <- BMXBMI",
    "agecat <- cases(age < 18, \"<18\", age < 40, \"18-39\", age < 65, \"40-64\", age >= 65, \"65+\")",
    "educ <- cases(DMDEDUC2 %in% c(1, 2), \"Less than high school\", DMDEDUC2 == 3, \"High school or GED\", DMDEDUC2 == 4, \"Some college\", DMDEDUC2 == 5, \"College graduate or above\")",
    "eosinophilia_05 <- aec >= 0.5",
    "# inclusion: age >= 18",
    "des <- svydesign(ids = ~SDMVPSU, strata = ~SDMVSTRA, weights = ~WT, nest = TRUE, data = <positive-weight records>)",
    "options(survey.lonely.psu = 'adjust'); subpopulations via subset(des, ...)",
    "svyciprop(~I(hypereosinophilia_15 == 1), subset(des, analytic), method = 'beta')  # by sex, agecat",
    "svyglm(hypereosinophilia_15 ~ sex + agecat + race_eth + pir_cat + bmi, design = <full>, family = quasipoisson)"
  ],
