  "derived": [
    {
      "name": "aec",
      "expr": "LBDEONO",
      "type": "continuous",
      "label": "Absolute eosinophil count",
      "levels": null
    },
    {
      "name": "eosinophilia_05",
      "expr": "aec >= 0.5",
      "type": "binary",
      "label": "Eosinophilia - absolute eosinophil count >=0.5 x10^9/L",
      "levels": null
    },
    {
      "name": "toxo_igg_2011",
      "expr": "SSTOXG",
      "type": "continuous",
      "label": "Toxoplasma IgG, 2011-2012 surplus sera (IU/mL)",
      "levels": null
    },
    {
      "name": "toxo_igg_9904",
      "expr": "coalesce(LBXTO1, LBDTO1)",
      "type": "continuous",
      "label": "Toxoplasma IgG, 1999-2004 (IU/mL)",
      "levels": null
    },
    {
      "name": "toxoplasma_seropos",
      "expr": "coalesce(toxo_igg_2011 >= 33, toxo_igg_9904 >= 10)",
      "type": "binary",
      "label": "Toxoplasma gondii seropositivity - IgG antibody positive",
      "levels": null
    },
    {
      "name": "toxocara_ab",
      "expr": "SSTCAR",
      "type": "categorical",
      "label": "Toxocara antibody result (1=positive, 2=negative)",
      "levels": null
    },
    {
      "name": "toxocara_seropos",
      "expr": "toxocara_ab == 1",
      "type": "binary",
      "label": "Toxocara seropositivity - IgG antibody positive (Luminex rTc-CTL-1, MFI >23.1)",
      "levels": null
    },
    {
      "name": "asthma",
      "expr": "MCQ010 == 1",
      "type": "binary",
      "label": "Asthma (ever told)",
      "levels": null
    },
    {
      "name": "dm_selfreport",
      "expr": "DIQ010 == 1",
      "type": "binary",
      "label": "Self-reported diabetes diagnosis",
      "levels": null
    },
    {
      "name": "insulin_use",
      "expr": "DIQ050 == 1",
      "type": "binary",
      "label": "Current insulin use",
      "levels": null
    },
    {
      "name": "dm_pills",
      "expr": "DIQ070 == 1",
      "type": "binary",
      "label": "Current oral diabetes medication",
      "levels": null
    },
    {
      "name": "hba1c",
      "expr": "LBXGH",
      "type": "continuous",
      "label": "HbA1c",
      "levels": null
    },
    {
      "name": "diabetes",
      "expr": "any_of(dm_selfreport, insulin_use, dm_pills, hba1c >= 6.5)",
      "type": "binary",
      "label": "Diabetes (self-report, medication, or HbA1c >=6.5%)",
      "levels": null
    },
    {
      "name": "chd",
      "expr": "MCQ160C == 1",
      "type": "binary",
      "label": "Coronary heart disease (self-report)",
      "levels": null
    },
    {
      "name": "mi",
      "expr": "MCQ160E == 1",
      "type": "binary",
      "label": "Heart attack (self-report)",
      "levels": null
    },
    {
      "name": "stroke",
      "expr": "MCQ160F == 1",
      "type": "binary",
      "label": "Stroke (self-report)",
      "levels": null
    },
    {
      "name": "hf",
      "expr": "MCQ160B == 1",
      "type": "binary",
      "label": "Heart failure (self-report)",
      "levels": null
    },
    {
      "name": "cvd",
      "expr": "any_of(chd, mi, stroke, hf)",
      "type": "binary",
      "label": "Cardiovascular disease (CHD, MI, stroke or HF)",
      "levels": null
    },
    {
      "name": "creatinine",
      "expr": "LBXSCR",
      "type": "continuous",
      "label": "Serum creatinine",
      "levels": null
    },
    {
      "name": "female",
      "expr": "RIAGENDR == 2",
      "type": "binary",
      "label": "Female sex",
      "levels": null
    },
    {
      "name": "age",
      "expr": "RIDAGEYR",
      "type": "continuous",
      "label": "Age",
      "levels": null
    },
    {
      "name": "egfr",
      "expr": "142 * pmin(creatinine / ifelse(female == 1, 0.7, 0.9), 1)^ifelse(female == 1, -0.241, -0.302) * pmax(creatinine / ifelse(female == 1, 0.7, 0.9), 1)^(-1.2) * 0.9938^age * ifelse(female == 1, 1.012, 1)",
      "type": "continuous",
      "label": "eGFR (CKD-EPI 2021, race-free)",
      "levels": null
    },
    {
      "name": "uacr",
      "expr": "URDACT",
      "type": "continuous",
      "label": "Urine albumin-to-creatinine ratio",
      "levels": null
    },
    {
      "name": "ckd",
      "expr": "any_of(egfr < 60, uacr >= 30)",
      "type": "binary",
      "label": "Chronic kidney disease (eGFR <60 or UACR >=30 mg/g)",
      "levels": null
    },
    {
      "name": "cancer_hx",
      "expr": "MCQ220 == 1",
      "type": "binary",
      "label": "History of cancer (self-report)",
      "levels": null
    },
    {
      "name": "liver_hx",
      "expr": "MCQ160L == 1",
      "type": "binary",
      "label": "Self-reported liver condition",
      "levels": null
    },
    {
      "name": "arms",
      "expr": "cases(is.na(toxoplasma_seropos) | is.na(toxocara_seropos), NA, coalesce(toxoplasma_seropos, 0) == 1 & coalesce(toxocara_seropos, 0) == 1, \"Both positive\", coalesce(toxoplasma_seropos, 0) == 1 & coalesce(toxocara_seropos, 0) == 0, \"Toxoplasma gondii only\", coalesce(toxocara_seropos, 0) == 1 & coalesce(toxoplasma_seropos, 0) == 0, \"Toxocara only\", toxoplasma_seropos == 0 & toxocara_seropos == 0 & coalesce(asthma, 0) == 0 & coalesce(diabetes, 0) == 0 & coalesce(cvd, 0) == 0 & coalesce(ckd, 0) == 0 & coalesce(cancer_hx, 0) == 0 & coalesce(liver_hx, 0) == 0, \"Healthy controls\")",
      "type": "categorical",
      "label": "Toxoplasma gondii vs Toxocara vs healthy controls",
      "levels": [
        "Healthy controls",
        "Toxoplasma gondii only",
        "Toxocara only",
        "Both positive"
      ]
    },
    {
      "name": "sex",
      "expr": "cases(female == 0, \"Male\", female == 1, \"Female\")",
      "type": "categorical",
      "label": "Sex",
      "levels": null
    },
    {
      "name": "race_eth",
      "expr": "coalesce(cases(RIDRETH3 == 3, \"Non-Hispanic White\", RIDRETH3 == 4, \"Non-Hispanic Black\", RIDRETH3 %in% c(1, 2), \"Hispanic\", RIDRETH3 == 6, \"Non-Hispanic Asian\", RIDRETH3 == 7, \"Other or multiracial\"), cases(RIDRETH1 == 3, \"Non-Hispanic White\", RIDRETH1 == 4, \"Non-Hispanic Black\", RIDRETH1 %in% c(1, 2), \"Hispanic\", RIDRETH1 == 5, \"Other or multiracial\"))",
      "type": "categorical",
      "label": "Race and ethnicity",
      "levels": null
    },
    {
      "name": "pir",
      "expr": "INDFMPIR",
      "type": "continuous",
      "label": "Family income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "pir_cat",
      "expr": "cases(pir < 1.3, \"<1.30\", pir < 3.5, \"1.30-3.49\", pir >= 3.5, \"3.50+\")",
      "type": "categorical",
      "label": "Income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "bmi",
      "expr": "BMXBMI",
      "type": "continuous",
      "label": "Body mass index",
      "levels": null
    },
    {
      "name": "us_born",
      "expr": "coalesce(DMDBORN4 == 1, DMDBORN2 == 1, DMDBORN == 1)",
      "type": "binary",
      "label": "Born in the United States",
      "levels": null
    },
    {
      "name": "agecat",
      "expr": "cases(age < 18, \"<18\", age < 40, \"18-39\", age < 65, \"40-64\", age >= 65, \"65+\")",
      "type": "categorical",
      "label": "Age group",
      "levels": null
    },
    {
      "name": "educ",
      "expr": "cases(DMDEDUC2 %in% c(1, 2), \"Less than high school\", DMDEDUC2 == 3, \"High school or GED\", DMDEDUC2 == 4, \"Some college\", DMDEDUC2 == 5, \"College graduate or above\")",
      "type": "categorical",
      "label": "Educational attainment",
      "levels": null
    },
    {
      "name": "hypereosinophilia_15",
      "expr": "aec >= 1.5",
      "type": "binary",
      "label": "Hypereosinophilia - absolute eosinophil count >=1.5 x10^9/L",
      "levels": null
    },
    {
      "name": "arms_seroneg",
      "expr": "cases(is.na(toxoplasma_seropos) | is.na(toxocara_seropos), NA, coalesce(toxoplasma_seropos, 0) == 1 & coalesce(toxocara_seropos, 0) == 1, \"Both positive\", coalesce(toxoplasma_seropos, 0) == 1 & coalesce(toxocara_seropos, 0) == 0, \"Toxoplasma gondii only\", coalesce(toxocara_seropos, 0) == 1 & coalesce(toxoplasma_seropos, 0) == 0, \"Toxocara only\", toxoplasma_seropos == 0 & toxocara_seropos == 0, \"Controls (negative for all)\")",
      "type": "categorical",
      "label": "Comparison groups (all seronegative controls)",
      "levels": [
        "Controls (negative for all)",
        "Toxoplasma gondii only",
        "Toxocara only",
        "Both positive"
      ]
    }
  ],
