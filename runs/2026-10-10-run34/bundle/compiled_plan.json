  "derived": [
    {
      "name": "creatinine",
      "expr": "LBXSCR",
      "type": "continuous",
      "label": "Serum creatinine",
      "levels": null
    },
    {
      "name": "female",
      "expr": "RIAGENDR == 2",
      "type": "binary",
      "label": "Female sex",
      "levels": null
    },
    {
      "name": "age",
      "expr": "RIDAGEYR",
      "type": "continuous",
      "label": "Age",
      "levels": null
    },
    {
      "name": "egfr",
      "expr": "142 * pmin(creatinine / ifelse(female == 1, 0.7, 0.9), 1)^ifelse(female == 1, -0.241, -0.302) * pmax(creatinine / ifelse(female == 1, 0.7, 0.9), 1)^(-1.2) * 0.9938^age * ifelse(female == 1, 1.012, 1)",
      "type": "continuous",
      "label": "eGFR (CKD-EPI 2021, race-free)",
      "levels": null
    },
    {
      "name": "uacr",
      "expr": "URDACT",
      "type": "continuous",
      "label": "Urine albumin-to-creatinine ratio",
      "levels": null
    },
    {
      "name": "ckd_kdigo",
      "expr": "any_of(egfr < 60, uacr >= 30)",
      "type": "binary",
      "label": "CKD - eGFR <60 or UACR >=30 mg/g (single measurement)",
      "levels": null
    },
    {
      "name": "sbp",
      "expr": "coalesce((BPXOSY1 + BPXOSY2 + BPXOSY3) / 3, (BPXSY1 + BPXSY2 + BPXSY3) / 3)",
      "type": "continuous",
      "label": "Systolic blood pressure (mean of readings)",
      "levels": null
    },
    {
      "name": "dbp",
      "expr": "coalesce((BPXODI1 + BPXODI2 + BPXODI3) / 3, (BPXDI1 + BPXDI2 + BPXDI3) / 3)",
      "type": "continuous",
      "label": "Diastolic blood pressure (mean of readings)",
      "levels": null
    },
    {
      "name": "bp_meds",
      "expr": "BPQ050A == 1",
      "type": "binary",
      "label": "Taking antihypertensive medication",
      "levels": null
    },
    {
      "name": "htn_accaha2017",
      "expr": "any_of(sbp >= 130, dbp >= 80, bp_meds)",
      "type": "binary",
      "label": "Hypertension - ACC/AHA 2017 (BP >=130/80 mm Hg or antihypertensive use)",
      "levels": null
    },
    {
      "name": "sex",
      "expr": "cases(female == 0, \"Male\", female == 1, \"Female\")",
      "type": "categorical",
      "label": "Sex",
      "levels": null
    },
    {
      "name": "race_eth",
      "expr": "coalesce(cases(RIDRETH3 == 3, \"Non-Hispanic White\", RIDRETH3 == 4, \"Non-Hispanic Black\", RIDRETH3 %in% c(1, 2), \"Hispanic\", RIDRETH3 == 6, \"Non-Hispanic Asian\", RIDRETH3 == 7, \"Other or multiracial\"), cases(RIDRETH1 == 3, \"Non-Hispanic White\", RIDRETH1 == 4, \"Non-Hispanic Black\", RIDRETH1 %in% c(1, 2), \"Hispanic\", RIDRETH1 == 5, \"Other or multiracial\"))",
      "type": "categorical",
      "label": "Race and ethnicity",
      "levels": null
    },
    {
      "name": "pir",
      "expr": "INDFMPIR",
      "type": "continuous",
      "label": "Family income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "pir_cat",
      "expr": "cases(pir < 1.3, \"<1.30\", pir < 3.5, \"1.30-3.49\", pir >= 3.5, \"3.50+\")",
      "type": "categorical",
      "label": "Income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "dm_selfreport",
      "expr": "DIQ010 == 1",
      "type": "binary",
      "label": "Self-reported diabetes diagnosis",
      "levels": null
    },
    {
      "name": "insulin_use",
      "expr": "DIQ050 == 1",
      "type": "binary",
      "label": "Current insulin use",
      "levels": null
    },
    {
      "name": "dm_pills",
      "expr": "DIQ070 == 1",
      "type": "binary",
      "label": "Current oral diabetes medication",
      "levels": null
    },
    {
      "name": "hba1c",
      "expr": "LBXGH",
      "type": "continuous",
      "label": "HbA1c",
      "levels": null
    },
    {
      "name": "diabetes",
      "expr": "any_of(dm_selfreport, insulin_use, dm_pills, hba1c >= 6.5)",
      "type": "binary",
