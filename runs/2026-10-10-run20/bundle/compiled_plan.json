  "derived": [
    {
      "name": "toxocara_ab",
      "expr": "SSTCAR",
      "type": "categorical",
      "label": "Toxocara antibody result (1=positive, 2=negative)",
      "levels": null
    },
    {
      "name": "toxo_igg_2011",
      "expr": "SSTOXG",
      "type": "continuous",
      "label": "Toxoplasma IgG, 2011-2012 surplus sera (IU/mL)",
      "levels": null
    },
    {
      "name": "parasite_any_2011",
      "expr": "any_of(toxocara_ab == 1, toxo_igg_2011 >= 33)",
      "type": "binary",
      "label": "Any measured parasite seropositivity - Toxocara or Toxoplasma IgG (2011-2012)",
      "levels": null
    },
    {
      "name": "age",
      "expr": "RIDAGEYR",
      "type": "continuous",
      "label": "Age",
      "levels": null
    },
    {
      "name": "female",
      "expr": "RIAGENDR == 2",
      "type": "binary",
      "label": "Female sex",
      "levels": null
    },
    {
      "name": "sex",
      "expr": "cases(female == 0, \"Male\", female == 1, \"Female\")",
      "type": "categorical",
      "label": "Sex",
      "levels": null
    },
    {
      "name": "race_eth",
      "expr": "coalesce(cases(RIDRETH3 == 3, \"Non-Hispanic White\", RIDRETH3 == 4, \"Non-Hispanic Black\", RIDRETH3 %in% c(1, 2), \"Hispanic\", RIDRETH3 == 6, \"Non-Hispanic Asian\", RIDRETH3 == 7, \"Other or multiracial\"), cases(RIDRETH1 == 3, \"Non-Hispanic White\", RIDRETH1 == 4, \"Non-Hispanic Black\", RIDRETH1 %in% c(1, 2), \"Hispanic\", RIDRETH1 == 5, \"Other or multiracial\"))",
      "type": "categorical",
      "label": "Race and ethnicity",
      "levels": null
    },
    {
      "name": "pir",
      "expr": "INDFMPIR",
      "type": "continuous",
      "label": "Family income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "pir_cat",
      "expr": "cases(pir < 1.3, \"<1.30\", pir < 3.5, \"1.30-3.49\", pir >= 3.5, \"3.50+\")",
      "type": "categorical",
      "label": "Income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "us_born",
      "expr": "coalesce(DMDBORN4 == 1, DMDBORN2 == 1, DMDBORN == 1)",
      "type": "binary",
      "label": "Born in the United States",
      "levels": null
    },
    {
      "name": "agecat",
      "expr": "cases(age < 18, \"<18\", age < 40, \"18-39\", age < 65, \"40-64\", age >= 65, \"65+\")",
      "type": "categorical",
      "label": "Age group",
      "levels": null
    },
    {
      "name": "educ",
      "expr": "cases(DMDEDUC2 %in% c(1, 2), \"Less than high school\", DMDEDUC2 == 3, \"High school or GED\", DMDEDUC2 == 4, \"Some college\", DMDEDUC2 == 5, \"College graduate or above\")",
      "type": "categorical",
      "label": "Educational attainment",
      "levels": null
    },
    {
      "name": "toxocara_seropos",
      "expr": "toxocara_ab == 1",
      "type": "binary",
      "label": "Toxocara seropositivity - IgG antibody positive (Luminex rTc-CTL-1, MFI >23.1)",
      "levels": null
    },
    {
      "name": "toxo_igg_9904",
      "expr": "coalesce(LBXTO1, LBDTO1)",
      "type": "continuous",
      "label": "Toxoplasma IgG, 1999-2004 (IU/mL)",
      "levels": null
    },
    {
      "name": "toxoplasma_seropos",
      "expr": "coalesce(toxo_igg_2011 >= 33, toxo_igg_9904 >= 10)",
      "type": "binary",
      "label": "Toxoplasma gondii seropositivity - IgG antibody positive",
      "levels": null
    }
  ],
