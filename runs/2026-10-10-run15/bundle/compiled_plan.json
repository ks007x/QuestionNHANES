  "derived": [
    {
      "name": "ferritin",
      "expr": "LBXFER",
      "type": "continuous",
      "label": "Serum ferritin",
      "levels": null
    },
    {
      "name": "tsat_reported",
      "expr": "LBDPCT",
      "type": "continuous",
      "label": "Transferrin saturation (reported)",
      "levels": null
    },
    {
      "name": "serum_iron",
      "expr": "LBXIRN",
      "type": "continuous",
      "label": "Serum iron",
      "levels": null
    },
    {
      "name": "tibc",
      "expr": "LBDTIB",
      "type": "continuous",
      "label": "Total iron-binding capacity",
      "levels": null
    },
    {
      "name": "tsat",
      "expr": "coalesce(tsat_reported, 100 * serum_iron / tibc)",
      "type": "continuous",
      "label": "Transferrin saturation",
      "levels": null
    },
    {
      "name": "fid_tawfik2024",
      "expr": "ferritin >= 30 & tsat < 20",
      "type": "binary",
      "label": "Functional iron deficiency - ferritin >=30 ng/mL with TSAT <20%",
      "levels": null
    },
    {
      "name": "age",
      "expr": "RIDAGEYR",
      "type": "continuous",
      "label": "Age",
      "levels": null
    },
    {
      "name": "female",
      "expr": "RIAGENDR == 2",
      "type": "binary",
      "label": "Female sex",
      "levels": null
    },
    {
      "name": "sex",
      "expr": "cases(female == 0, \"Male\", female == 1, \"Female\")",
      "type": "categorical",
      "label": "Sex",
      "levels": null
    },
    {
      "name": "race_eth",
      "expr": "cases(RIDRETH3 == 3, \"Non-Hispanic White\", RIDRETH3 == 4, \"Non-Hispanic Black\", RIDRETH3 %in% c(1, 2), \"Hispanic\", RIDRETH3 == 6, \"Non-Hispanic Asian\", RIDRETH3 == 7, \"Other or multiracial\")",
      "type": "categorical",
      "label": "Race and ethnicity",
      "levels": null
    },
    {
      "name": "pir",
      "expr": "INDFMPIR",
      "type": "continuous",
      "label": "Family income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "pir_cat",
      "expr": "cases(pir < 1.3, \"<1.30\", pir < 3.5, \"1.30-3.49\", pir >= 3.5, \"3.50+\")",
      "type": "categorical",
      "label": "Income-to-poverty ratio",
      "levels": null
    },
    {
      "name": "bmi",
      "expr": "BMXBMI",
      "type": "continuous",
      "label": "Body mass index",
      "levels": null
    },
    {
      "name": "crp",
      "expr": "LBXHSCRP",
      "type": "continuous",
      "label": "High-sensitivity C-reactive protein",
      "levels": null
    },
    {
      "name": "inflammation",
      "expr": "crp > 5",
      "type": "binary",
      "label": "Systemic inflammation (hsCRP >5 mg/L)",
      "levels": null
    },
    {
      "name": "creatinine",
      "expr": "LBXSCR",
      "type": "continuous",
      "label": "Serum creatinine",
      "levels": null
    },
    {
      "name": "egfr",
      "expr": "142 * pmin(creatinine / ifelse(female == 1, 0.7, 0.9), 1)^ifelse(female == 1, -0.241, -0.302) * pmax(creatinine / ifelse(female == 1, 0.7, 0.9), 1)^(-1.2) * 0.9938^age * ifelse(female == 1, 1.012, 1)",
      "type": "continuous",
      "label": "eGFR (CKD-EPI 2021, race-free)",
      "levels": null
    },
    {
      "name": "uacr",
      "expr": "URDACT",
      "type": "continuous",
      "label": "Urine albumin-to-creatinine ratio",
      "levels": null
    },
    {
      "name": "ckd",
      "expr": "any_of(egfr < 60, uacr >= 30)",
      "type": "binary",
      "label": "Chronic kidney disease (eGFR <60 or UACR >=30 mg/g)",
      "levels": null
    },
    {
      "name": "agecat",
      "expr": "cases(age < 18, \"<18\", age < 40, \"18-39\", age < 65, \"40-64\", age >= 65, \"65+\")",
      "type": "categorical",
      "label": "Age group",
      "levels": null
    },
    {
      "name": "educ",
      "expr": "cases(DMDEDUC2 %in% c(1, 2), \"Less than high school\", DMDEDUC2 == 3, \"High school or GED\", DMDEDUC2 == 4, \"Some college\", DMDEDUC2 == 5, \"College graduate or above\")",
      "type": "categorical",
      "label": "Educational attainment",
      "levels": null
    },
    {
      "name": "aid_tawfik2024",
      "expr": "ferritin < 30",
      "type": "binary",
      "label": "Absolute iron deficiency - ferritin <30 ng/mL",
      "levels": null
    },
    {
      "name": "fid_esc_hf",
      "expr": "ferritin < 100 | (ferritin >= 100 & ferritin < 300 & tsat < 20)",
      "type": "binary",
      "label": "Iron deficiency (heart-failure definition) - ferritin <100, or 100-299 with TSAT <20%",
      "levels": null
    },
    {
      "name": "anemia_tx",
      "expr": "MCQ053 == 1",
      "type": "binary",
      "label": "Treated for anemia in past 3 months",
      "levels": null
    },
    {
      "name": "pregnant",
      "expr": "coalesce(RIDEXPRG, 2) == 1",
      "type": "binary",
      "label": "Pregnant at examination",
      "levels": null
    }
  ],
