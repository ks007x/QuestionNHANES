{
  "openapi": "3.0.3",
  "info": {
    "title": "Q2E AI Research Copilot tools",
    "version": "1.0.0",
    "description": "Clinical question -> reproducible NHANES study. Humans approve; AI drafts, checks and runs approved plans."
  },
  "servers": [
    {
      "url": "https://YOUR-Q2E-HOST"
    }
  ],
  "paths": {
    "/api/tools/assess_question": {
      "post": {
        "operationId": "assess_question",
        "summary": "Check whether NHANES can answer a research question (design fit, coverage, eligibility) without creating a project.",
        "description": "Check whether NHANES can answer a research question (design fit, coverage, eligibility) without creating a project.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "description": "Research question in plain English"
                  },
                  "cycles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "NHANES cycles, e.g. ['P'] (2017-Mar 2020) or ['L'] (2021-2023)"
                  }
                },
                "required": [
                  "question"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Tool error (e.g., plan not approved by a human)"
          }
        },
        "security": [
          {
            "q2eKey": []
          }
        ]
      }
    },
    "/api/tools/design_study": {
      "post": {
        "operationId": "design_study",
        "summary": "Turn a research idea into a draft NHANES protocol (PICO, variables, analysis plan, feasibility, design audit). Returns p",
        "description": "Turn a research idea into a draft NHANES protocol (PICO, variables, analysis plan, feasibility, design audit). Returns project_id. Hard-stops questions NHANES cannot answer.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "description": "Clinical observation or research question"
                  },
                  "cycles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "NHANES cycles, e.g. ['P'] (2017-Mar 2020) or ['L'] (2021-2023)"
                  },
                  "data_source": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "cdc",
                      "synthetic"
                    ],
                    "description": "auto/cdc = real NHANES (local files or CDC download); synthetic = offline demo data"
                  }
                },
                "required": [
                  "question"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Tool error (e.g., plan not approved by a human)"
          }
        },
        "security": [
          {
            "q2eKey": []
          }
        ]
      }
    },
    "/api/tools/get_plan": {
      "post": {
        "operationId": "get_plan",
        "summary": "Read the current protocol, reviewer critique and design-audit flags for a project.",
        "description": "Read the current protocol, reviewer critique and design-audit flags for a project.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": {
                    "type": "string",
                    "description": "Project id returned by design_study"
                  }
                },
                "required": [
                  "project_id"
                ],
                "additionalProperties": false
              }
