# ---- Data -------------------------------------------------------------------
# Folder with NHANES .xpt files (e.g. the hackathon-provided extracts). File names as on CDC: P_DEMO.xpt, DEMO_J.xpt ...
Q2E_NHANES_DIR=./data/nhanes
# Download missing NHANES files from wwwn.cdc.gov and cache them (true/false)
Q2E_ALLOW_DOWNLOAD=true
Q2E_WORKSPACE=./workspace

# ---- AI agents --------------------------------------------------------------
# offline | anthropic | azure_openai | bedrock | openai | ollama
Q2E_LLM_PROVIDER=offline
# public (default for public-use NHANES) | restricted (only Q2E_APPROVED_PROVIDERS; no aggregates sent to LLMs)
Q2E_DATA_POLICY=public
Q2E_APPROVED_PROVIDERS=offline,ollama,azure_openai,bedrock
Q2E_SEND_AGGREGATES=true

# Anthropic
ANTHROPIC_API_KEY=
Q2E_ANTHROPIC_MODEL=claude-sonnet-5-5
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# AWS Bedrock (uses the standard AWS credential chain)
AWS_REGION=us-east-1
Q2E_BEDROCK_MODEL_ID=
# Any OpenAI-compatible gateway
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
Q2E_OPENAI_MODEL=
# Local model through Ollama (stays on your machine - suitable for restricted data)
OLLAMA_BASE_URL=http://localhost:11434/v1
Q2E_OLLAMA_MODEL=llama3.1

# ---- Voice (ElevenLabs) -----------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# ---- PubMed (optional, raises E-utilities rate limits) ----------------------
NCBI_EMAIL=
NCBI_API_KEY=
